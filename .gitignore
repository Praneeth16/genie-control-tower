# Local secrets and per-workspace ids
.env
# The bundle supplies the app's command and environment (resources/app.yml); never commit a local app.yaml.
app/app.yaml
.env.*
!app/.env.example

# Per-deployment bundle state and variable overrides (they carry workspace ids)
.databricks/

# Generated: recreated by the setup scripts, and workspace-specific
genie/space_ids.json
data/out/
data/row_counts.json
app/backend/row_counts.json
eval/results/

# Generated corpus — rebuilt from the warehouse by data/generate_documents.py
data/documents/

# Build output and dependencies
node_modules/
app/frontend/dist/
app/frontend/tsconfig.tsbuildinfo
__pycache__/
*.pyc
.venv/
# FE Bar build
.databricks/
*.pem
.code-review-graph/
