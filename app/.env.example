# Copy to .env in the REPO ROOT and fill in. Every value is workspace-specific; there are no defaults,
# so a missing one fails at startup with a message naming it rather than silently pointing somewhere else.
#
# `databricks bundle deploy` sets the same values on the deployed app from databricks.yml variables —
# this file is only for running the app and the scripts locally.

# --- Auth ---------------------------------------------------------------------
# Databricks CLI profile. Omit to use the default profile / DATABRICKS_HOST + token.
DATABRICKS_CONFIG_PROFILE=

# --- Unity Catalog ------------------------------------------------------------
# The catalog must already exist and you must be able to CREATE SCHEMA in it.
CT_CATALOG=
CT_SCHEMA=control_tower_banking
CT_VOLUME=docs

# --- Compute ------------------------------------------------------------------
# Serverless SQL warehouse id: Databricks SQL > Warehouses > your warehouse > Connection details.
DATABRICKS_WAREHOUSE_ID=
# Any chat model serving endpoint. Used by the supervisor's router and answer fuser.
DATABRICKS_CHAT_ENDPOINT=databricks-claude-sonnet-4-5

# --- Lakebase (approval state machine, action lineage) ------------------------
# An existing Lakebase / serverless Postgres instance name. There is a per-workspace quota, so you may
# need to reuse one; state is isolated by LAKEBASE_SCHEMA, not by instance.
LAKEBASE_INSTANCE=
LAKEBASE_DBNAME=databricks_postgres
LAKEBASE_SCHEMA=control_tower

# --- Genie Agents -------------------------------------------------------------
# Written by `python3 genie/create_genie_agents.py --create` into genie/space_ids.json. Copy them here.
# A blank id degrades that one domain to instruction-driven text2sql instead of blanking the app.
COLLECTIONS_SPACE_ID=
GRIEVANCE_SPACE_ID=
RM_SPACE_ID=

# --- AI/BI dashboard (optional) ----------------------------------------------
# Printed by `python3 dashboards/build_dashboard.py --deploy`.
DASHBOARD_ID=

# --- Vector Search (optional) -------------------------------------------------
# Semantic search over the letter corpus. Endpoints are shared, billable, per-workspace resources, so
# this project does NOT create one: `databricks vector-search-endpoints list-endpoints` to find yours.
# Leave blank and the Documents tab says search is unconfigured; everything else works.
VS_ENDPOINT=
VS_INDEX=
VS_EMBEDDING_ENDPOINT=databricks-gte-large-en

# --- Observability ------------------------------------------------------------
MLFLOW_EXPERIMENT=/Shared/genie-control-tower
TRACING_ENABLED=true

# --- Identity -----------------------------------------------------------------
# TRUE in the deployed app: refuse a request with no forwarded user token rather than reading as the
# service principal. FALSE locally, where those headers do not exist.
REQUIRE_OBO=false

# First Control Tower Administrator / approver. Blank = whoever runs the install.
CT_ADMIN_PRINCIPAL=

# --- Naming ---------------------------------------------------------------------
# The institution this demo depicts. It appears on GENERATED CUSTOMER CORRESPONDENCE — letterheads,
# grievance intake forms, compliance notes. The default is deliberately unmistakable; set a real
# institution's name only when presenting to that institution, and never publish the output.
BANK_NAME=Demo Retail Bank

# Prefix for the account groups the row filters and column masks check
# (<prefix>_ai_coe, <prefix>_auditors, <prefix>_pii_readers, <prefix>_grievance_ops, ...).
# Create those groups, or the filters fall through to the region_entitlement table only.
GROUP_PREFIX=control_tower

# Salt for the customer-id pseudonym. Must be identical everywhere and STABLE FOREVER: change it and every
# pseudonym changes, so any join against data masked with the old salt silently returns nothing.
# In production this belongs in a secret scope, not here.
PSEUDONYM_SALT=control-tower-pseudonym-v1
