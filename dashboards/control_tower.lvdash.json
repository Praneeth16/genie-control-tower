{
  "datasets": [
    {
      "name": "gnpa_region",
      "displayName": "GNPA % by region (Aug 2026)",
      "queryLines": [
        "SELECT b.region,\n",
        "       ROUND(100.0 * SUM(CASE WHEN d.is_npa THEN d.outstanding_principal ELSE 0 END)\n",
        "                   / SUM(d.outstanding_principal), 1) AS gnpa_pct,\n",
        "       ROUND(SUM(d.outstanding_principal) / 10000000.0, 1) AS exposure_cr\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.delinquency_monthly d\n",
        "JOIN serverless_lakebase_praneeth_catalog.control_tower_banking.branch_master b ON d.branch_id = b.branch_id\n",
        "WHERE d.snapshot_month = DATE'2026-08-01'\n",
        "GROUP BY b.region\n",
        "ORDER BY gnpa_pct DESC\n"
      ]
    },
    {
      "name": "delinq_product",
      "displayName": "Delinquency % by product (Aug 2026)",
      "queryLines": [
        "SELECT product_code,\n",
        "       ROUND(100.0 * SUM(CASE WHEN dpd_days > 0 THEN 1 ELSE 0 END) / COUNT(*), 1) AS delinquency_pct\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.delinquency_monthly\n",
        "WHERE snapshot_month = DATE'2026-08-01'\n",
        "GROUP BY product_code\n",
        "ORDER BY delinquency_pct DESC\n"
      ]
    },
    {
      "name": "mfi_solapur_trend",
      "displayName": "Solapur microfinance delinquency trend",
      "queryLines": [
        "SELECT d.snapshot_month,\n",
        "       ROUND(100.0 * SUM(CASE WHEN d.dpd_days > 0 THEN 1 ELSE 0 END) / COUNT(*), 1) AS delinquency_pct\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.delinquency_monthly d\n",
        "JOIN serverless_lakebase_praneeth_catalog.control_tower_banking.branch_master b ON d.branch_id = b.branch_id\n",
        "WHERE d.product_code = 'MFI' AND b.city = 'Solapur'\n",
        "GROUP BY d.snapshot_month\n",
        "ORDER BY d.snapshot_month\n"
      ]
    },
    {
      "name": "conduct_kpis",
      "displayName": "Out-of-hours contact attempts",
      "queryLines": [
        "SELECT COUNT(*) AS out_of_hours_attempts\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.collections_activity\n",
        "WHERE within_rbi_hours = FALSE\n"
      ]
    },
    {
      "name": "uncertified_kpi",
      "displayName": "Uncertified agents making contact (2026)",
      "queryLines": [
        "SELECT COUNT(DISTINCT a.agent_id) AS uncertified_agents_contacting\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.collections_activity a\n",
        "JOIN serverless_lakebase_praneeth_catalog.control_tower_banking.recovery_agents r ON a.agent_id = r.agent_id\n",
        "WHERE r.rbi_conduct_certified = FALSE\n",
        "  AND a.activity_date >= DATE'2026-01-01'\n"
      ]
    },
    {
      "name": "agency_conduct",
      "displayName": "Conduct exposure by agency",
      "queryLines": [
        "SELECT r.agency_name,\n",
        "       COUNT(*) AS attempts,\n",
        "       SUM(CASE WHEN a.within_rbi_hours = FALSE THEN 1 ELSE 0 END) AS out_of_hours,\n",
        "       ROUND(100.0 * SUM(CASE WHEN a.within_rbi_hours = FALSE THEN 1 ELSE 0 END) / COUNT(*), 1) AS out_of_hours_pct\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.collections_activity a\n",
        "JOIN serverless_lakebase_praneeth_catalog.control_tower_banking.recovery_agents r ON a.agent_id = r.agent_id\n",
        "GROUP BY r.agency_name\n",
        "ORDER BY out_of_hours_pct DESC\n"
      ]
    },
    {
      "name": "conduct_to_grievance",
      "displayName": "Conduct breaches and the complaints they produce, by city",
      "queryLines": [
        "WITH contact AS (\n",
        "  SELECT b.city, COUNT(*) AS attempts,\n",
        "         SUM(CASE WHEN a.within_rbi_hours = FALSE THEN 1 ELSE 0 END) AS out_of_hours,\n",
        "         COUNT(DISTINCT a.loan_account_id) AS accounts_contacted\n",
        "  FROM serverless_lakebase_praneeth_catalog.control_tower_banking.collections_activity a\n",
        "  JOIN serverless_lakebase_praneeth_catalog.control_tower_banking.branch_master b ON a.branch_id = b.branch_id\n",
        "  GROUP BY b.city),\n",
        "rec AS (\n",
        "  SELECT b.city, COUNT(DISTINCT c.complaint_id) AS recovery_complaints\n",
        "  FROM serverless_lakebase_praneeth_catalog.control_tower_banking.complaints c\n",
        "  JOIN serverless_lakebase_praneeth_catalog.control_tower_banking.complaint_categories cc ON c.category_code = cc.category_code\n",
        "  JOIN serverless_lakebase_praneeth_catalog.control_tower_banking.loan_accounts l ON c.customer_id = l.customer_id\n",
        "  JOIN serverless_lakebase_praneeth_catalog.control_tower_banking.branch_master b ON l.branch_id = b.branch_id\n",
        "  WHERE cc.rbi_category = 'Recovery agents'\n",
        "  GROUP BY b.city)\n",
        "SELECT contact.city,\n",
        "       contact.out_of_hours AS out_of_hours_contacts,\n",
        "       ROUND(100.0 * contact.out_of_hours / contact.attempts, 1) AS out_of_hours_pct,\n",
        "       COALESCE(rec.recovery_complaints, 0) AS recovery_complaints\n",
        "FROM contact LEFT JOIN rec ON contact.city = rec.city\n",
        "ORDER BY out_of_hours_contacts DESC\n"
      ]
    },
    {
      "name": "sla_category",
      "displayName": "SLA breach % by RBI ground (Aug 2026)",
      "queryLines": [
        "SELECT rbi_category,\n",
        "       ROUND(100.0 * SUM(breached_sla) / SUM(complaints_received), 1) AS breach_rate_pct\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.sla_tracker\n",
        "WHERE report_month = DATE'2026-08-01'\n",
        "GROUP BY rbi_category\n",
        "ORDER BY breach_rate_pct DESC\n"
      ]
    },
    {
      "name": "upi_incident",
      "displayName": "June 2026 UPI switch incident",
      "queryLines": [
        "SELECT txn_date,\n",
        "       COUNT(*) AS disputes,\n",
        "       ROUND(100.0 * SUM(CASE WHEN auto_refunded THEN 1 ELSE 0 END) / COUNT(*), 1) AS auto_refund_pct\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.upi_disputes\n",
        "WHERE txn_date BETWEEN DATE'2026-06-01' AND DATE'2026-06-30'\n",
        "GROUP BY txn_date\n",
        "ORDER BY txn_date\n"
      ]
    },
    {
      "name": "ombudsman_kpi",
      "displayName": "Ombudsman escalations",
      "queryLines": [
        "SELECT COUNT(*) AS ombudsman_escalations\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.complaints\n",
        "WHERE escalated_to_ombudsman = TRUE\n"
      ]
    },
    {
      "name": "open_past_sla_kpi",
      "displayName": "Open complaints past SLA",
      "queryLines": [
        "SELECT COUNT(*) AS open_past_sla\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.complaints\n",
        "WHERE status = 'Open' AND DATEDIFF(DATE'2026-08-31', received_date) > sla_days\n"
      ]
    },
    {
      "name": "escalation_category",
      "displayName": "Ombudsman escalation rate by ground",
      "queryLines": [
        "SELECT c.rbi_category,\n",
        "       COUNT(*) AS complaints,\n",
        "       SUM(CASE WHEN x.escalated_to_ombudsman THEN 1 ELSE 0 END) AS escalated,\n",
        "       ROUND(100.0 * SUM(CASE WHEN x.escalated_to_ombudsman THEN 1 ELSE 0 END) / COUNT(*), 2) AS escalation_pct\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.complaints x\n",
        "JOIN serverless_lakebase_praneeth_catalog.control_tower_banking.complaint_categories c ON x.category_code = c.category_code\n",
        "GROUP BY c.rbi_category\n",
        "ORDER BY escalation_pct DESC\n"
      ]
    },
    {
      "name": "clawback_kpi",
      "displayName": "RMs over-attaining but failing the quality gate",
      "queryLines": [
        "SELECT COUNT(DISTINCT rm_id) AS rms_in_clawback_cohort\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.rm_achievement\n",
        "WHERE attainment_pct >= 120 AND product_mix_score < 0.50\n"
      ]
    },
    {
      "name": "incentive_paid_kpi",
      "displayName": "Incentive paid, Aug 2026 (INR lakh)",
      "queryLines": [
        "SELECT ROUND(SUM(incentive_earned) / 100000.0, 1) AS incentive_paid_lakh\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.rm_achievement\n",
        "WHERE achievement_month = DATE'2026-08-01'\n"
      ]
    },
    {
      "name": "incentive_mix_band",
      "displayName": "Average incentive at >=120% attainment, by quality gate",
      "queryLines": [
        "SELECT CASE WHEN product_mix_score < 0.50 THEN 'Failed quality gate'\n",
        "            ELSE 'Cleared quality gate' END AS mix_band,\n",
        "       ROUND(AVG(incentive_earned), 0) AS avg_incentive,\n",
        "       COUNT(*) AS rm_months\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.rm_achievement\n",
        "WHERE attainment_pct >= 120\n",
        "GROUP BY 1\n"
      ]
    },
    {
      "name": "incentive_per_million",
      "displayName": "Incentive per INR million of business, by grade",
      "queryLines": [
        "SELECT rm_grade,\n",
        "       ROUND(1000000.0 * SUM(incentive_earned) / SUM(actual_casa_amount + actual_loan_amount), 2)\n",
        "         AS incentive_per_million\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.rm_achievement\n",
        "WHERE achievement_month >= DATE'2026-03-01'\n",
        "GROUP BY rm_grade\n",
        "ORDER BY incentive_per_million DESC\n"
      ]
    },
    {
      "name": "clawback_grade",
      "displayName": "Clawback rate by grade",
      "queryLines": [
        "SELECT rm_grade,\n",
        "       COUNT(*) AS rm_months,\n",
        "       SUM(CASE WHEN clawback_flag THEN 1 ELSE 0 END) AS clawback_months,\n",
        "       ROUND(100.0 * SUM(CASE WHEN clawback_flag THEN 1 ELSE 0 END) / COUNT(*), 1) AS clawback_rate_pct\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.rm_achievement\n",
        "GROUP BY rm_grade\n",
        "ORDER BY clawback_rate_pct DESC\n"
      ]
    },
    {
      "name": "casa_attainment_region",
      "displayName": "CASA attainment % by region (Aug 2026)",
      "queryLines": [
        "SELECT a.region,\n",
        "       ROUND(100.0 * SUM(a.actual_casa_amount) / SUM(t.target_casa_amount), 1) AS casa_attainment_pct\n",
        "FROM serverless_lakebase_praneeth_catalog.control_tower_banking.rm_achievement a\n",
        "JOIN serverless_lakebase_praneeth_catalog.control_tower_banking.rm_targets t ON a.rm_id = t.rm_id AND a.achievement_month = t.target_month\n",
        "WHERE a.achievement_month = DATE'2026-08-01'\n",
        "GROUP BY a.region\n",
        "ORDER BY casa_attainment_pct DESC\n"
      ]
    }
  ],
